# AgentaOS Gateway Configuration
# Reverse proxy for API and user apps

{
    # Global options
    auto_https off
    admin off
}

:80 {
    # API routes
    handle /api/* {
        reverse_proxy agentaos-api:3000
    }

    # WebSocket
    handle /ws {
        reverse_proxy agentaos-api:3000
    }

    # User app routes - API handles dynamic routing to containers
    # API looks up app by route, proxies to the correct container
    handle /apps/* {
        reverse_proxy agentaos-api:3000
    }

    # Static UI files
    handle {
        root * /srv/ui
        try_files {path} /index.html
        file_server
    }

    # Logging
    log {
        output stdout
        format console
    }
}
